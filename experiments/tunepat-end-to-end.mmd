flowchart TD
  UI["NHKページの動画検出"] -->|"fetch-data"| APP["Electron制御部<br/>NHK用処理・保存管理"]
  APP -. "共通API接続は名称・ログと整合<br/>バイトコード内部の詳細は未復元" .-> MC["libMediaConvert<br/>命令・IPCの仲介"]
  MC -->|"Convert"| HANDLE["media_handle<br/>設定・プロセス管理"]
  HANDLE -->|"起動＋IPCでジョブ送信"| FF["同梱FFmpeg<br/>独自media入力"]
  FF -->|"Initialize / ReadHeader / ReadPacket"| T["libTranscodeDLL"]
  T -->|"Download要求"| MC
  MC -->|"アプリ側コールバック"| DOWNLOAD["取得処理<br/>HTTP実装の詳細は未復元"]
  DOWNLOAD -->|"取得結果"| MC
  MC -->|"DownloadResult"| T
  DOWNLOAD -. "取得ファイル" .-> FILE["配信の断片ファイル"]
  FILE --> READER["MediaDataReader<br/>サンプル読み込み"]
  T --> READER
  READER -->|"処理対象のサンプル"| PROXY["wv_shell内のプロキシ"]
  PROXY -->|"映像処理インターフェース"| CDM["Widevine CDM"]
  CDM -->|"VideoFrame"| PROXY
  PROXY --> SHM["共有メモリの画素<br/>＋PlainDataの寸法・配置・時刻"]
  SHM --> PACKET["受信・MediaDataBuffer<br/>ReadPacket / AVPacket"]
  PACKET --> ADAPTER["media_decoder<br/>AVFrameへの参照を作る"]
  ADAPTER --> ENCODE["H.264 VideoToolbox<br/>映像を再圧縮"]
  ENCODE --> MP4["MP4へ格納<br/>今回：5分・約257MB"]
  MP4 -->|"完了結果"| HANDLE

